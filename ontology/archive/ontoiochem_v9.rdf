<?xml version='1.0' encoding='utf-8'?>
<rdf:RDF xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:iochem="http://purl.org/iochem/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://purl.org/iochem/ontoiochem">
        <dc:created>2026-10-07</dc:created>
        <dc:description>OntoIochem is an ontology designed to provide a semantic layer for the ioChem-BD platform and to support the consistent representation, discovery, and interoperability of computational chemistry data. Its development builds upon existing semantic resources, including the Gainesville ontology, which provided an important foundation for the representation of computational chemistry concepts and terminology. OntoIochem describes four main conceptual areas: the Molecular Concept, representing molecular structures and the properties that characterize them; the Calculation Concept, representing computational methodologies, software tools, calculation metadata, and derived results; the Publication Concept, representing information associated with scientific publications and research outputs, including data collections and manuscripts; and auxiliary concepts, such as units of measurement and values, which support the precise and machine-readable representation of scientific information. OntoIochem is designed to align with established computational chemistry ontologies and commonly used scientific terminologies, promoting semantic interoperability, reuse, and integration with existing resources and scientific data ecosystems.</dc:description>
        <iochem:canonicalUnitPolicy xml:lang="en">Numerical values represented by OntoIochem use canonical SI units. Source-program units are normalized during ingestion; SPARQL queries therefore operate on SI values without requiring unit conversion.</iochem:canonicalUnitPolicy>
        <rdfs:comment>An ontology for publishing results of computational chemistry in ioChem-BD</rdfs:comment>
        <rdfs:comment xml:lang="en">OntoIochem uses SI units as canonical units for numerical values. Values from computational chemistry programs are normalized during ingestion so that SPARQL queries operate on a consistent unit system.</rdfs:comment>
        <rdfs:label>OntoIochem Core Ontology</rdfs:label>
        <owl:versionInfo>0.7.0</owl:versionInfo>
        <owl:versionIRI rdf:resource="http://purl.org/iochem/ontoiochem/0.7.0" />
        <rdfs:comment>v9: molecular ChargeSum path and minimal datatype properties; named classes, class axioms and individuals unchanged from v8.</rdfs:comment>
    </owl:Ontology>
    <owl:AnnotationProperty rdf:about="http://purl.org/iochem/canonicalUnitPolicy">
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/created">
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description">
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="http://purl.org/iochem/elementName">
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="http://purl.org/iochem/gcSource" />
    <owl:AnnotationProperty rdf:about="http://creativecommons.org/ns#license">
    </owl:AnnotationProperty>
    <owl:AnnotationProperty rdf:about="http://purl.org/iochem/meaning">
        <rdfs:comment xml:lang="en">Meaning of the entity in the ioChem-BD semantic layer.</rdfs:comment>
        <rdfs:label xml:lang="en">Meaning</rdfs:label>
    </owl:AnnotationProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/auxiliaryProperty">
        <rdfs:label>auxiliary property</rdfs:label>
        <rdfs:comment xml:lang="en">Organizational superproperty. No domain, range or transitivity is imposed; grouping does not classify its subjects.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasComponentX">
        <rdfs:label>has component x</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iochem/VectorValue" />
        <rdfs:range rdf:resource="http://purl.org/iochem/FloatValue" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/auxiliaryProperty" />
        <rdfs:comment xml:lang="en">Cartesian x component of this vector. Numeric literal is stored with hasFloatValue on the component node; canonical SI unit is attached with unit.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasComponentY">
        <rdfs:label>has component y</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iochem/VectorValue" />
        <rdfs:range rdf:resource="http://purl.org/iochem/FloatValue" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/auxiliaryProperty" />
        <rdfs:comment xml:lang="en">Cartesian y component of this vector. Numeric literal is stored with hasFloatValue on the component node; canonical SI unit is attached with unit.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasComponentZ">
        <rdfs:label>has component z</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iochem/VectorValue" />
        <rdfs:range rdf:resource="http://purl.org/iochem/FloatValue" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/auxiliaryProperty" />
        <rdfs:comment xml:lang="en">Cartesian z component of this vector. Numeric literal is stored with hasFloatValue on the component node; canonical SI unit is attached with unit.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasNumericalValue">
        <rdfs:label>has numerical value</rdfs:label>
        <rdfs:range rdf:resource="http://purl.org/iochem/Value" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/auxiliaryProperty" />
        <rdfs:comment xml:lang="en">Scientific entity to its value representation. For scalar decimals use FloatValue; for vectors use VectorValue. The scientific class identifies the quantity.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasVectorRepresentation">
        <rdfs:label>has vector representation</rdfs:label>
        <rdfs:range rdf:resource="http://purl.org/iochem/VectorValue" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/hasNumericalValue" />
        <rdfs:comment xml:lang="en">Coordinates or Dipole to a vector value. One vector represents one coordinate frame or one dipole result, without mixing unrelated axes.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/unit">
        <rdfs:comment xml:lang="en">Canonical SI unit associated with a numerical value in OntoIochem.</rdfs:comment>
        <rdfs:comment xml:lang="en">Unit associated with the numerical value of a calculated result.</rdfs:comment>
        <rdfs:label>unit</rdfs:label>
        <iochem:gcSource rdf:resource="http://purl.org/gc/hasUnit" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/auxiliaryProperty" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/calculationProperty">
        <rdfs:label>calculation property</rdfs:label>
        <rdfs:comment xml:lang="en">Organizational superproperty. No domain, range or transitivity is imposed; grouping does not classify its subjects.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasAtomicProperties">
        <rdfs:label>has atomic properties</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iochem/CalculationResults" />
        <rdfs:range rdf:resource="http://purl.org/iochem/AtomicProperties" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/calculationProperty" />
        <rdfs:comment xml:lang="en">Calculation results to their atom-level property entities.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasMulliken">
        <rdfs:label>has mulliken</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iochem/CalculationResults" />
        <rdfs:range rdf:resource="http://purl.org/iochem/Mulliken" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/hasAtomicProperties" />
        <rdfs:comment xml:lang="en">Mulliken analysis entity. Its hasNumericalValue is used for the atomic partial charge when that is the intended observable; Mulliken can also represent other population-analysis results.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasCalculationResult">
        <rdfs:label>has calculation result</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept" />
        <rdfs:range rdf:resource="http://purl.org/iochem/CalculationResults" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/calculationProperty" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasEnergy">
        <rdfs:label>has energy</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iochem/CalculationResults" />
        <rdfs:range rdf:resource="http://purl.org/gc/SystemEnergies" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/calculationProperty" />
        <rdfs:comment xml:lang="en">Result to an existing energy/thermodynamic quantity entity. Its specific type is ElectronicEnergy, FreeEnergy, BondingEnergy, HOMO, LUMO, DispersionEnergy, ThermalEnergy, ThermalEntalpy, TotalEntropy or ZPEenergy as already defined. The existing classification of TotalEntropy is preserved; no claim that entropy is physically an energy is made.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/usesMethod">
        <rdfs:label>has methodology feature</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept" />
        <rdfs:range rdf:resource="http://purl.org/iochem/MetodologyFeature" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/calculationProperty" />
        <rdfs:comment xml:lang="en">Generic methodology relation; existing IRI preserved.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/usesBasisSet">
        <rdfs:label>has basis set</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept" />
        <rdfs:range rdf:resource="http://purl.org/gc/BasisSet" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/usesMethod" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/usesDensityFunctional">
        <rdfs:label>has density functional</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept" />
        <rdfs:range rdf:resource="http://purl.org/gc/DensityFunctional" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/usesMethod" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasParameterSet">
        <rdfs:label>has parameter set</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept" />
        <rdfs:range rdf:resource="http://purl.org/gc/ParameterSet" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/usesMethod" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/usesProgram">
        <rdfs:label>has program</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept" />
        <rdfs:range rdf:resource="http://purl.org/iochem/Program" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/usesMethod" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasMolecularSystem">
        <rdfs:label>has molecular system</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept" />
        <rdfs:range rdf:resource="http://purl.org/gc/MolecularSystem" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/calculationProperty" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasSystemProperty">
        <rdfs:label>has system property</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iochem/CalculationResults" />
        <rdfs:range rdf:resource="http://purl.org/iochem/CalculatedSystem" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/calculationProperty" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/dipole">
        <rdfs:label>has dipole</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iochem/CalculatedSystem" />
        <rdfs:range rdf:resource="http://purl.org/iochem/Dipole" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/hasSystemProperty" />
        <rdfs:comment xml:lang="en">Dipole entity to vector representation using hasVectorRepresentation. No average or magnitude relation is added.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasPolarizability">
        <rdfs:label>has polarizability</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iochem/CalculatedSystem" />
        <rdfs:range rdf:resource="http://purl.org/iochem/Polarizability" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/hasSystemProperty" />
        <rdfs:comment xml:lang="en">Existing polarizability entity. A scalar FloatValue can represent a defined scalar observable; no tensor-specific classes or component relations are invented.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/isPropertyOfAtom">
        <rdfs:label>is property of atom</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iochem/AtomicProperties" />
        <rdfs:range rdf:resource="http://purl.org/gc/Atom" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/calculationProperty" />
        <rdfs:comment xml:lang="en">Associate an atom-level analysis/property entity with the atom it describes; does not treat molecular total charge as an atomic charge.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/molecularProperty">
        <rdfs:label>molecular property</rdfs:label>
        <rdfs:comment xml:lang="en">Organizational superproperty. No domain, range or transitivity is imposed; grouping does not classify its subjects.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasAtom">
        <rdfs:label>has atom</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/Molecule" />
        <rdfs:range rdf:resource="http://purl.org/gc/Atom" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/molecularProperty" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasChargeSum">
        <rdfs:label>has charge sum</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/Molecule" />
        <rdfs:range rdf:resource="http://purl.org/iochem/ChargeSum" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/molecularProperty" />
        <rdfs:comment>Molecule to its specified total charge entity (input/structural descriptor). The ChargeSum value follows hasNumericalValue; not an atomic partial charge or calculation output.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/coordinates">
        <rdfs:label>has coordinates</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/Atom" />
        <rdfs:range rdf:resource="http://purl.org/iochem/Coordinates" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/molecularProperty" />
        <rdfs:comment xml:lang="en">Atom to its coordinate entity. Coordinates → hasVectorRepresentation → VectorValue → hasComponentX/Y/Z → FloatValue. Legacy direct datatype components remain unchanged but are not the recommended v8 path.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasMolecularDescription">
        <rdfs:label>has molecular description</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/MolecularSystem" />
        <rdfs:range rdf:resource="http://purl.org/iochem/MolecularDescription" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/molecularProperty" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasMolecularQuantity">
        <rdfs:label>has molecular quantity</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/MolecularConcept" />
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/gc/AtomicMass" />
                    <rdf:Description rdf:about="http://purl.org/iochem/MolarMass" />
                    <rdf:Description rdf:about="http://purl.org/iochem/MolecularMass" />
                    <rdf:Description rdf:about="http://purl.org/iochem/AtomCount" />
                    <rdf:Description rdf:about="http://purl.org/iochem/AtomicNumber" />
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/molecularProperty" />
        <rdfs:comment xml:lang="en">Molecular or element entity to explicitly defined mass/count/atomic-number quantity. Molecular total charge exclusively uses hasChargeSum from Molecule. Scalar value is represented by hasNumericalValue.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasMolecule">
        <rdfs:label>has molecule</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/MolecularSystem" />
        <rdfs:range rdf:resource="http://purl.org/gc/Molecule" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/molecularProperty" />
        <rdfs:comment xml:lang="en">Molecular system to a constituent molecule. The v7 calculation-to-molecule shortcut is replaced by calculation → molecular system → molecule.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/isElement">
        <rdfs:label>is element</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/Atom" />
        <rdfs:range rdf:resource="http://www.daml.org/2003/01/periodictable/PeriodicTable#Element" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/molecularProperty" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/publicationProperty">
        <rdfs:label>publication property</rdfs:label>
        <rdfs:comment xml:lang="en">Organizational superproperty. No domain, range or transitivity is imposed; grouping does not classify its subjects.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasAuthor">
        <rdfs:label>has author</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/Publication" />
        <rdfs:range rdf:resource="http://purl.org/iochem/Authors" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/publicationProperty" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasCollection">
        <rdfs:label>has collection</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iochem/Data" />
        <rdfs:range rdf:resource="http://purl.org/iochem/Collection" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/publicationProperty" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasFile">
        <rdfs:label>has file</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/Publication" />
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/iochem/Article" />
                    <rdf:Description rdf:about="http://purl.org/iochem/Data" />
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/publicationProperty" />
        <rdfs:comment xml:lang="en">Publication to an existing Article or Data entity used as manuscript/data resource. This is not a generic physical-file class or a file URL; addresses remain literals. Article and Data are the only allowed alternatives.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasInstitution">
        <rdfs:label>has institution</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/Publication" />
        <rdfs:range rdf:resource="http://purl.org/iochem/Institution" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/publicationProperty" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasItem">
        <rdfs:label>has item</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iochem/Collection" />
        <rdfs:range rdf:resource="http://purl.org/iochem/Item" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/publicationProperty" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasJournal">
        <rdfs:label>has journal</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iochem/Article" />
        <rdfs:range rdf:resource="http://purl.org/iochem/Journal" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/publicationProperty" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasPublication">
        <rdfs:label>has publication</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept" />
        <rdfs:range rdf:resource="http://purl.org/gc/Publication" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/publicationProperty" />
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasPublicationMetadata">
        <rdfs:label>has publication metadata</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/gc/PublicationConcept" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/publicationProperty" />
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/iochem/Subjects" />
                    <rdf:Description rdf:about="http://purl.org/iochem/URI" />
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Publication-related object, including Collection, to the existing Subjects or URI descriptor entity. Connects the retained literal subjects/uri fields without creating new classes.</rdfs:comment>
    </owl:ObjectProperty>
    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/auxiliaryData">
        <rdfs:label>auxiliary data</rdfs:label>
        <rdfs:comment>Organizational datatype superproperty with no domain/range inference. No object/data property IRI is shared.</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/hasName">
        <rdfs:label>has name</rdfs:label>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/iochem/Authors" />
                    <rdf:Description rdf:about="http://purl.org/gc/BasisSet" />
                    <rdf:Description rdf:about="http://purl.org/gc/DensityFunctional" />
                    <rdf:Description rdf:about="http://purl.org/iochem/Institution" />
                    <rdf:Description rdf:about="http://purl.org/iochem/Journal" />
                    <rdf:Description rdf:about="http://purl.org/iochem/Program" />
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/auxiliaryData" />
        <rdfs:comment>Shared human-readable name of existing entities. Alternative domains are an OWL union, not multiple domain axioms (which would imply intersection).</rdfs:comment>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/hasValue">
        <rdfs:label>has value</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iochem/Value" />
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/auxiliaryData" />
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/hasFloatValue">
        <rdfs:label>has float value</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iochem/FloatValue" />
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double" />
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/hasValue" />
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/hasIntegerValue">
