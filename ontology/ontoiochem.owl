    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/subjects">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/publicationData"/>
        <rdfs:domain rdf:resource="http://purl.org/iochem/Subjects"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>subjects</rdfs:label>
    </owl:DatatypeProperty>
    


