        <rdfs:label>publication data</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iochem/smiles -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/smiles">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/molecularData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>smiles</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iochem/MolecularDescription"/>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iochem/stoichiometry -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/stoichiometry">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/molecularData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>stoichiometry</rdfs:label>
    </owl:DatatypeProperty>
    


