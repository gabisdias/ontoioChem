    </owl:Class>
    


    <!-- http://purl.org/iochem/ConvergenceStatus -->

    <owl:Class rdf:about="http://purl.org/iochem/ConvergenceStatus">
        <rdfs:subClassOf rdf:resource="http://purl.org/gc/CalculatedSystemProperties"/>
        <iochem:meaning xml:lang="en">Convergence status of the calculation</iochem:meaning>
        <rdfs:label xml:lang="en">ConvergenceStatus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/iochem/CoordinatesInput -->

    <owl:Class rdf:about="http://purl.org/iochem/CoordinatesInput">
        <rdfs:subClassOf rdf:resource="http://purl.org/gc/MolecularSystem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iochem/unit"/>
                <owl:hasValue rdf:resource="http://purl.org/iochem/Meter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <iochem:meaning xml:lang="en">Coords</iochem:meaning>
        <rdfs:label xml:lang="en">CoordinatesInput</rdfs:label>
