<?xml version="1.0"?>
<rdf:RDF xmlns="http://purl.org/iochem/ontoiochem#"
     xml:base="http://purl.org/iochem/ontoiochem"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://creativecommons.org/ns#"
     xmlns:ns1="http://purl.org/iochem/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://purl.org/iochem/ontoiochem">
        <owl:versionIRI rdf:resource="http://purl.org/iochem/ontoiochem.owl"/>
        <dc:created>2026-10-06</dc:created>
        <dc:description>OntoIochem is an ontology designed to provide a semantic layer for the ioChem-BD platform and to support the consistent representation, discovery, and interoperability of computational chemistry data. Its development builds upon existing semantic resources, including the Gainesville ontology, which provided an important foundation for the representation of computational chemistry concepts and terminology. OntoIochem describes four main conceptual areas: the Molecular Concept, representing molecular structures and the properties that characterize them; the Calculation Concept, representing computational methodologies, software tools, calculation metadata, and derived results; the Publication Concept, representing information associated with scientific publications and research outputs, including data collections and manuscripts; and auxiliary concepts, such as units of measurement and values, which support the precise and machine-readable representation of scientific information. OntoIochem is designed to align with established computational chemistry ontologies and commonly used scientific terminologies, promoting semantic interoperability, reuse, and integration with existing resources and scientific data ecosystems.</dc:description>
        <rdfs:comment rdf:resource=""/>
        <rdfs:comment>An ontology for publishing results of computational chemistry in ioChem-BD</rdfs:comment>
        <rdfs:label>OntoIochem Core Ontology</rdfs:label>
        <owl:versionInfo>0.4.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://creativecommons.org/ns#license -->

    <owl:AnnotationProperty rdf:about="http://creativecommons.org/ns#license"/>
    


    <!-- http://purl.org/dc/elements/1.1/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/created"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/iochem/elementName -->

    <owl:AnnotationProperty rdf:about="http://purl.org/iochem/elementName"/>
    


    <!-- http://purl.org/iochem/meaning -->

    <owl:AnnotationProperty rdf:about="http://purl.org/iochem/meaning">
        <rdfs:comment xml:lang="en">Meaning of the entity in the ioChem-BD semantic layer.</rdfs:comment>
        <rdfs:label xml:lang="en">Meaning</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/iochem/atomicPropertyConceptOf -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/atomicPropertyConceptOf">
        <owl:inverseOf rdf:resource="http://purl.org/iochem/hasAtomicPropertyConcept"/>
        <rdfs:domain rdf:resource="http://purl.org/iochem/AtomicProperties"/>
        <rdfs:range rdf:resource="http://purl.org/gc/Atom"/>
        <rdfs:comment xml:lang="en">Inverse relation of hasAtomicPropertyConcept.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/calculationDescribesMolecularSystem -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/calculationDescribesMolecularSystem">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/describesMolecularSystem"/>
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept"/>
        <rdfs:range rdf:resource="http://purl.org/gc/MolecularSystem"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.org/iochem/hasResult"/>
            <rdf:Description rdf:about="http://purl.org/iochem/describesMolecularSystem"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/describesMolecularSystem -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/describesMolecularSystem"/>
    


    <!-- http://purl.org/iochem/hasArticle -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasArticle">
        <rdfs:domain rdf:resource="http://purl.org/gc/Publication"/>
        <rdfs:range rdf:resource="http://purl.org/iochem/Article"/>
        <rdfs:comment>Links a publication to an article.</rdfs:comment>
        <rdfs:label>hasArticle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasAtom -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasAtom">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/hasPart"/>
        <owl:inverseOf rdf:resource="http://purl.org/iochem/isAtomOf"/>
        <rdfs:domain rdf:resource="http://purl.org/gc/Molecule"/>
        <rdfs:range rdf:resource="http://purl.org/gc/Atom"/>
        <rdfs:comment>Links a molecule to one of its atoms.</rdfs:comment>
        <rdfs:comment xml:lang="en">Links a molecule to one of its atoms.</rdfs:comment>
        <rdfs:label>hasAtom</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasAtomicProperties -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasAtomicProperties">
        <rdfs:domain rdf:resource="http://purl.org/iochem/CalculationResults"/>
        <rdfs:range rdf:resource="http://purl.org/iochem/AtomicProperties"/>
        <rdfs:comment>Links results to atomic properties.</rdfs:comment>
        <rdfs:label>hasAtomicProperties</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasAtomicPropertyConcept -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasAtomicPropertyConcept">
        <rdfs:domain rdf:resource="http://purl.org/gc/Atom"/>
        <rdfs:range rdf:resource="http://purl.org/iochem/AtomicProperties"/>
        <rdfs:comment xml:lang="en">Links an atom to the conceptual type of atomic property calculated for it.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasAuthor -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasAuthor">
        <rdfs:domain rdf:resource="http://purl.org/gc/Publication"/>
        <rdfs:range rdf:resource="http://purl.org/iochem/Authors"/>
        <rdfs:comment>Links a publication to its authors.</rdfs:comment>
        <rdfs:label>hasAuthor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasCalculatedProperty -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasCalculatedProperty">
        <rdfs:domain rdf:resource="http://purl.org/iochem/CalculationResults"/>
        <rdfs:range rdf:resource="http://purl.org/iochem/CalculationProperties"/>
        <rdfs:comment>Links calculation results to a calculated property.</rdfs:comment>
        <rdfs:label>hasCalculatedProperty</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasCalculatedSystem -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasCalculatedSystem">
        <rdfs:domain rdf:resource="http://purl.org/iochem/CalculationProperties"/>
        <rdfs:range rdf:resource="http://purl.org/iochem/CalculatedSystem"/>
        <rdfs:comment>Links calculated properties to the calculated system.</rdfs:comment>
        <rdfs:label>hasCalculatedSystem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasCalculationEnergy -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasCalculationEnergy">
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept"/>
        <rdfs:range rdf:resource="http://purl.org/gc/SystemEnergies"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.org/iochem/hasCalculationResult"/>
            <rdf:Description rdf:about="http://purl.org/iochem/hasSystemEnergy"/>
        </owl:propertyChainAxiom>
        <rdfs:label>hasCalculationEnergy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasCalculationResult -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasCalculationResult">
        <owl:inverseOf rdf:resource="http://purl.org/iochem/isCalculationResultOf"/>
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept"/>
        <rdfs:range rdf:resource="http://purl.org/iochem/CalculationResults"/>
        <owl:propertyDisjointWith rdf:resource="http://purl.org/iochem/hasMolecule"/>
        <rdfs:comment>Links a calculation to its calculated results.</rdfs:comment>
        <rdfs:label>hasCalculationResult</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasCollection -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasCollection">
        <rdfs:domain rdf:resource="http://purl.org/iochem/Data"/>
        <rdfs:range rdf:resource="http://purl.org/iochem/Collection"/>
        <rdfs:comment>Links computational chemistry data to a collection.</rdfs:comment>
        <rdfs:label>hasCollection</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasElectronicProperties -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasElectronicProperties">
        <rdfs:domain rdf:resource="http://purl.org/iochem/CalculationResults"/>
        <rdfs:range rdf:resource="http://purl.org/iochem/ElectronicProperties"/>
        <rdfs:comment>Links results to electronic properties.</rdfs:comment>
        <rdfs:label>hasElectronicProperties</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasInstitution -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasInstitution">
        <rdfs:domain rdf:resource="http://purl.org/gc/Publication"/>
        <rdfs:range rdf:resource="http://purl.org/iochem/Institution"/>
        <rdfs:comment>Links a publication to an institution.</rdfs:comment>
        <rdfs:label>hasInstitution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasItem -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasItem">
        <rdfs:domain rdf:resource="http://purl.org/iochem/Collection"/>
        <rdfs:range rdf:resource="http://purl.org/iochem/Item"/>
        <rdfs:comment>Links a collection to an item.</rdfs:comment>
        <rdfs:label>hasItem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasJournal -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasJournal">
        <rdfs:domain rdf:resource="http://purl.org/iochem/Article"/>
        <rdfs:range rdf:resource="http://purl.org/iochem/Journal"/>
        <rdfs:comment>Links an article to its journal.</rdfs:comment>
        <rdfs:label>hasJournal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasMolecularDescription -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasMolecularDescription">
        <rdfs:domain rdf:resource="http://purl.org/gc/MolecularSystem"/>
        <rdfs:range rdf:resource="http://purl.org/iochem/MolecularDescription"/>
        <rdfs:comment>Links a molecular system to its molecular description.</rdfs:comment>
        <rdfs:label>hasMolecularDescription</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasMolecularSystem -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasMolecularSystem">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept"/>
        <rdfs:range rdf:resource="http://purl.org/gc/MolecularSystem"/>
        <rdfs:comment>Links a calculation to its molecular system.</rdfs:comment>
        <rdfs:label>hasMolecularSystem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasMolecule -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasMolecule">
        <owl:inverseOf rdf:resource="http://purl.org/iochem/isMoleculeOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept"/>
        <rdfs:range rdf:resource="http://purl.org/gc/Molecule"/>
        <rdfs:comment xml:lang="en">Links a calculation to the molecular structure used in the calculation.</rdfs:comment>
        <rdfs:comment>Links a calculation to the molecular system represented by a molecule.</rdfs:comment>
        <rdfs:label>hasMolecule</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasParameterSet -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasParameterSet">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/usesMethod"/>
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept"/>
        <rdfs:range rdf:resource="http://purl.org/gc/ParameterSet"/>
        <rdfs:comment>Links a calculation to its parameter set.</rdfs:comment>
        <rdfs:label>hasParameterSet</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasPart -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasPart">
        <owl:inverseOf rdf:resource="http://purl.org/iochem/partOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/gc/MolecularStructureObject"/>
        <rdfs:range rdf:resource="http://purl.org/gc/MolecularStructureObject"/>
        <rdfs:comment>Inverse of partOf; links a molecular structure object to its structural parts.</rdfs:comment>
        <rdfs:label>hasPart</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasPublication -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasPublication">
        <rdfs:domain rdf:resource="http://purl.org/iochem/Data"/>
        <rdfs:range rdf:resource="http://purl.org/gc/Publication"/>
        <rdfs:comment>Links computational chemistry data to its publication.</rdfs:comment>
        <rdfs:label>hasPublication</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/hasResult -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasResult"/>
    


    <!-- http://purl.org/iochem/hasSystemEnergy -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/hasSystemEnergy">
        <rdfs:domain rdf:resource="http://purl.org/iochem/CalculationResults"/>
        <rdfs:range rdf:resource="http://purl.org/gc/SystemEnergies"/>
        <rdfs:comment>Links calculation results to a system energy.</rdfs:comment>
        <rdfs:label>hasSystemEnergy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/isAtomOf -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/isAtomOf">
        <rdfs:domain rdf:resource="http://purl.org/gc/Atom"/>
        <rdfs:range rdf:resource="http://purl.org/gc/Molecule"/>
        <rdfs:comment xml:lang="en">Inverse relation of hasAtom.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/isCalculationResultOf -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/isCalculationResultOf">
        <rdfs:domain rdf:resource="http://purl.org/iochem/CalculationResults"/>
        <rdfs:range rdf:resource="http://purl.org/gc/CalculationConcept"/>
        <rdfs:comment>Links calculation results to the calculation that produced them.</rdfs:comment>
        <rdfs:label>isCalculationResultOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/isMoleculeOf -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/isMoleculeOf">
        <rdfs:domain rdf:resource="http://purl.org/gc/Molecule"/>
        <rdfs:range rdf:resource="http://purl.org/gc/CalculationConcept"/>
        <rdfs:comment xml:lang="en">Inverse relation of hasMolecule.</rdfs:comment>
        <rdfs:comment>Links a molecule to the calculation in which it is used.</rdfs:comment>
        <rdfs:label>isMoleculeOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/isProgramOf -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/isProgramOf">
        <owl:inverseOf rdf:resource="http://purl.org/iochem/usesProgram"/>
        <rdfs:domain rdf:resource="http://purl.org/iochem/Program"/>
        <rdfs:range rdf:resource="http://purl.org/gc/CalculationConcept"/>
        <rdfs:comment>Links a program to calculations that use it.</rdfs:comment>
        <rdfs:label>isProgramOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/partOf -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/partOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/gc/MolecularStructureObject"/>
        <rdfs:range rdf:resource="http://purl.org/gc/MolecularStructureObject"/>
        <rdfs:comment>Indicates that a molecular structure object is a structural part of another object.</rdfs:comment>
        <rdfs:label>partOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/usesBasisSet -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/usesBasisSet">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/usesMethod"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept"/>
        <rdfs:range rdf:resource="http://purl.org/gc/BasisSet"/>
        <owl:propertyDisjointWith rdf:resource="http://purl.org/iochem/usesProgram"/>
        <rdfs:comment>Links a calculation to the basis set used.</rdfs:comment>
        <rdfs:label>usesBasisSet</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/usesDensityFunctional -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/usesDensityFunctional">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/usesMethod"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept"/>
        <rdfs:range rdf:resource="http://purl.org/gc/DensityFunctional"/>
        <rdfs:comment>Links a calculation to the density functional used.</rdfs:comment>
        <rdfs:label>usesDensityFunctional</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/usesMethod -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/usesMethod">
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept"/>
        <rdfs:range rdf:resource="http://purl.org/iochem/MetodologyFeature"/>
        <rdfs:comment>Links a calculation to its methodology features.</rdfs:comment>
        <rdfs:label>usesMethod</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iochem/usesProgram -->

    <owl:ObjectProperty rdf:about="http://purl.org/iochem/usesProgram">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/iochem/usesMethod"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/gc/CalculationConcept"/>
        <rdfs:range rdf:resource="http://purl.org/iochem/Program"/>
        <rdfs:comment>Links a calculation to the computational chemistry program used.</rdfs:comment>
        <rdfs:label>usesProgram</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/iochem/articleIdentifier -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/articleIdentifier">
        <rdfs:domain rdf:resource="http://purl.org/iochem/Article"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>articleIdentifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iochem/atomCount -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/atomCount">
        <rdfs:domain rdf:resource="http://purl.org/gc/Molecule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>atomCount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iochem/atomIndex -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/atomIndex">
        <rdfs:domain rdf:resource="http://purl.org/gc/Atom"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Index identifying the atom within the molecular structure.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iochem/atomicMass -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/atomicMass">
        <rdfs:domain rdf:resource="http://www.daml.org/2003/01/periodictable/PeriodicTable#Element"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:label>atomicMass</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iochem/atomicNumber -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/atomicNumber">
        <rdfs:domain rdf:resource="http://www.daml.org/2003/01/periodictable/PeriodicTable#Element"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>atomicNumber</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iochem/authorName -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/authorName">
        <rdfs:domain rdf:resource="http://purl.org/iochem/Authors"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>authorName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iochem/basisSetName -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/basisSetName">
        <rdfs:domain rdf:resource="http://purl.org/gc/BasisSet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>basisSetName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iochem/bondingEnergy -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/bondingEnergy">
        <rdfs:domain rdf:resource="http://purl.org/gc/SystemEnergies"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:label>bondingEnergy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iochem/chargeSum -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/chargeSum">
        <rdfs:domain rdf:resource="http://purl.org/gc/Molecule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:label>chargeSum</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iochem/convergenceStatus -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iochem/convergenceStatus">
        <rdfs:domain rdf:resource="http://purl.org/iochem/CalculatedSystem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>convergenceStatus</rdfs:label>
    </owl:DatatypeProperty>
    


